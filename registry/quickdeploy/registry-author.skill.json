{
  "apiVersion": "quickdeploy.ai/v1",
  "kind": "AgentSkillManifest",
  "metadata": {
    "name": "ai.quickdeploy/registry-author",
    "version": "0.1.0",
    "title": "Registry Author",
    "description": "Author and review QuickDeploy agent-skill registry entries.",
    "labels": ["quickdeploy", "registry", "authoring"]
