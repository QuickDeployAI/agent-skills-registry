{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quickdeploy.ai/skillset.v1.schema.json",
  "title": "QuickDeploy Skill Set v1",
  "description": "Pinned reference to skills hosted in an external repository, aligned with the skills-lock.json consumer pin format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "quickdeploy.ai/v1"
    },
    "kind": {
      "const": "SkillSet"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "labels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills"],
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pinnedSkill"
          }
        }
      }
    },
    "_meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "pinnedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "sourceType", "skillPath", "computedHash"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "sourceType": {
          "enum": ["github"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "skillPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "SKILL\\.md$"
        },
        "computedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
