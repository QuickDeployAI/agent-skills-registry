{
  "name": "@quickdeployai/agent-skills-registry-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for building and validating the QuickDeploy agent skills registry.",
  "type": "module",
  "bin": {
    "agent-skills-registry-cli": "./src/cli.mts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "registry:build": "tsx src/cli.mts build",
    "registry:check": "tsx src/cli.mts check",
    "registry:validate": "tsx src/cli.mts validate"
  },
  "dependencies": {
    "@quickdeployai/agent-skill-core": "workspace:*",
    "@quickdeployai/agent-skill-registry-schemas": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
