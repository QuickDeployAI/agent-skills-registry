{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quickdeploy.ai/skill-manifest.v1.schema.json",
  "title": "QuickDeploy Skill Manifest v1",
  "description": "Declarative source-to-skill manifest consumed by QuickDeploy skill importers and registry tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "quickdeploy.ai/v1"
    },
    "kind": {
      "const": "SkillManifest"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "_meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^ai\\.quickdeploy/[a-zA-Z0-9._-]+$"
        },
        "version": {
          "$ref": "#/$defs/exactVersion"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "labels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "skill", "safety", "output"],
      "properties": {
        "importer": {
          "$ref": "#/$defs/importer"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "select": {
          "$ref": "#/$defs/select"
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "skill": {
          "$ref": "#/$defs/skillFrontmatter"
        },
        "safety": {
          "$ref": "#/$defs/safety"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/referenceItem"
          }
        },
        "scripts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/scriptItem"
          }
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "type": {
                    "enum": ["http", "git"]
                  }
                },
                "required": ["type"]
              }
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "source": {
                "required": ["digest"]
              }
            }
          }
        }
      ]
    },
    "importer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "versionRange"],
      "properties": {
        "engine": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*-2-agent-skills$"
        },
        "versionRange": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri"],
      "properties": {
        "type": {
          "enum": ["http", "file", "git"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "destructive": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "uriTemplate"],
            "properties": {
              "method": {
                "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"]
              },
              "uriTemplate": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "docGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "graphqlOperations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name"],
            "properties": {
              "type": {
                "enum": ["query", "mutation"]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": true
        },
        "defaults": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "skillFrontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "type": "string",
          "minLength": 1
        },
        "allowed-tools": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "sandbox"],
      "properties": {
        "readOnly": {
          "type": "boolean",
          "default": true
        },
        "destructiveOperations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "confirmation"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "confirmation": {
                "const": "explicit"
              }
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "defaultMode"],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "defaultMode": {
              "enum": ["sandbox", "production"],
              "default": "sandbox"
            },
            "switchEnvVar": {
              "$ref": "#/$defs/envName"
            }
          }
        },
        "secretsPolicy": {
          "const": "env-names-only",
          "default": "env-names-only"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "readOnly": {
                "const": false
              }
            },
            "required": ["readOnly"]
          },
          "then": {
            "required": ["destructiveOperations"],
            "properties": {
              "destructiveOperations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["cli", "mcp"]
              },
              "versionRange": {
                "type": "string",
                "minLength": 1
              },
              "installHint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "env": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "$ref": "#/$defs/envName"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "secret": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "referenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/skillRelativePath"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scriptItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "allowlistedByDefault"],
      "properties": {
        "path": {
          "$ref": "#/$defs/skillRelativePath"
        },
        "allowlistedByDefault": {
          "const": false
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "skillRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(scripts|references|assets)/[^\\0]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "\\.\\."
          },
          {
            "pattern": "^/"
          }
        ]
      }
    },
    "exactVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
    }
  }
}
