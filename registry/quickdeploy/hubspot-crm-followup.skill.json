    },
    "safety": {
      "readOnly": true,
      "destructiveOperations": [],
      "sandbox": {
        "supported": true,
        "defaultMode": "sandbox",
        "switchEnvVar": "HUBSPOT_LIVE_MODE"
      },
      "secretsPolicy": "env-names-only"
    },
    "requirements": {
      "tools": [],
      "env": [
        {
          "name": "HUBSPOT_ACCESS_TOKEN",
          "description": "Private-app access token with read-only CRM scopes.",
          "required": true,
          "secret": true
        }
      ]
    },
    "references": [
      {
        "path": "references/api-endpoints.md",
